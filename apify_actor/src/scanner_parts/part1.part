class UnsafeUrlError(ValueError):
    pass


class DnsResolutionError(RuntimeError):
    pass


class ResponseTooLargeError(RuntimeError):
    pass


@dataclass(frozen=True)
class FetchResult:
    requested_url: str
    final_url: str
    status_code: int
    headers: dict[str, str]
    body: bytes
    redirect_count: int


class PageParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.title_parts: list[str] = []
        self.meta_description: str | None = None
        self.generator: str | None = None
        self.canonical_href: str | None = None
        self.language: str | None = None
        self.forms = 0
        self.mailto_emails: set[str] = set()
        self.tel_phones: set[str] = set()
        self.social_profiles: dict[str, set[str]] = {name: set() for name in SOCIAL_HOSTS}
        self.visible_text_parts: list[str] = []
        self.structured_data_types: set[str] = set()
        self.organization_name: str | None = None
        self._in_title = False
        self._ignored_depth = 0
        self._in_json_ld = False
        self._json_ld_parts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        tag_lower = tag.lower()
        attrs_dict = {k.lower(): (v or "") for k, v in attrs}
        if tag_lower == "html" and attrs_dict.get("lang") and self.language is None:
            self.language = attrs_dict["lang"].strip()[:50] or None
        if tag_lower in {"script", "style", "noscript"}:
            self._ignored_depth += 1
        if tag_lower == "script" and attrs_dict.get("type", "").lower() == "application/ld+json":
            self._in_json_ld = True
            self._json_ld_parts = []
        if tag_lower == "title":
            self._in_title = True
        elif tag_lower == "meta":
            meta_name = attrs_dict.get("name", "").lower()
            if meta_name == "description" and self.meta_description is None and attrs_dict.get("content"):
                self.meta_description = " ".join(attrs_dict["content"].split())[:500]
            elif meta_name == "generator" and self.generator is None and attrs_dict.get("content"):
                self.generator = " ".join(attrs_dict["content"].split())[:200]
        elif tag_lower == "link" and self.canonical_href is None:
            rel = attrs_dict.get("rel", "").lower().split()
            if "canonical" in rel and attrs_dict.get("href"):
                self.canonical_href = attrs_dict["href"].strip()
        elif tag_lower == "form":
            self.forms += 1
        elif tag_lower == "a":
            href = attrs_dict.get("href", "").strip()
            href_lower = href.lower()
            if href_lower.startswith("mailto:"):
                candidate = href[7:].split("?", 1)[0].strip()
                if EMAIL_RE.fullmatch(candidate):
