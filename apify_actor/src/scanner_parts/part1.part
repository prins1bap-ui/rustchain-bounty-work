def _patterns(*values: str) -> tuple[re.Pattern[str], ...]:
    return tuple(re.compile(value, re.I) for value in values)


TECH_PATTERNS: dict[str, tuple[re.Pattern[str], ...]] = {
    # CMS / site builders / ecommerce
    "WordPress": _patterns(r"wp-content/", r"wp-includes/", r"content=[\"'][^\"']*wordpress"),
